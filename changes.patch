+/// What a new link shows at first: what the user's Privacy settings already show to everybody. Everything it lets
+/// people do starts allowed.
+struct ProfileLinkDefaults {
+    var showPhoneNumber: Bool = false
+    var showBirthday: Bool = true
+    var showBio: Bool = true
+    var showLastSeen: Bool = true
+    var showGifts: Bool = true
+
+    init() {
+    }
+
+    init(privacy: AccountPrivacySettings) {
+        func isOpen(_ setting: SelectivePrivacySettings) -> Bool {
+            if case .enableEveryone = setting {
+                return true
+            }
+            return false
+        }
+        self.showPhoneNumber = isOpen(privacy.phoneNumber)
+        self.showBirthday = isOpen(privacy.birthday)
+        self.showBio = isOpen(privacy.bio)
+        self.showLastSeen = isOpen(privacy.presence)
+        self.showGifts = isOpen(privacy.giftsAutoSave)
+    }
+}
