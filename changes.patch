+        private func loadProfileLinksIfNeeded(context: AccountContext) {
+            guard !self.didLoadProfileLinks, self.profileLinksEnabled else {
+                return
+            }
+            self.didLoadProfileLinks = true
+            self.profileLinks = Array(ProfileLinksStore.load(accountPeerId: context.account.peerId).prefix(ProfileLinkLimits.maxLinks - 1))
+            self.topicIconsDisposable = (context.engine.stickers.loadedStickerPack(reference: .iconTopicEmoji, forceActualized: false)
+            |> deliverOnMainQueue).startStrict(next: { [weak self] result in
+                guard let self, case let .result(_, items, _) = result else {
+                    return
+                }
+                var files: [String: TelegramMediaFile] = [:]
+                for item in items {
+                    let file = item.file._parse()
+                    for attribute in file.attributes {
