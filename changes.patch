+enum ProfileLinkLimits {
+    /// Links in total, the built-in Public one included.
+    static let maxLinks = 5
+}
+
+/// The icons a link can take: custom emoji of the official forum topic icon pack, looked up by their emoji.
+enum ProfileLinkIcons {
+    static let defaultEmoji = "🔗"
+
+    static func suggestedEmoji(name: String) -> String {
+        let lowered = name.lowercased()
+        let table: [(keys: [String], emoji: String)] = [
+            (["univ", "school", "study", "college", "class", "campus"], "🎓"),
+            (["work", "job", "office", "business", "colleague"], "💼"),
+            (["home", "family", "house"], "🏠"),
+            (["love", "partner", "close", "friend"], "❤️"),
+            (["travel", "trip"], "✈️"),
+            (["game", "gaming"], "🎮"),
+            (["music", "band"], "🎵"),
+            (["sport", "gym", "football"], "⚽️")
+        ]
+        for entry in table where entry.keys.contains(where: { lowered.contains($0) }) {
+            return entry.emoji
+        }
+        return self.defaultEmoji
+    }
+}
+
+/// Local storage of the user's profile links, per account.
+enum ProfileLinksStore {
+    private static func key(accountPeerId: EnginePeer.Id) -> String {
+        return "profileLinks.\(accountPeerId.toInt64())"
+    }
+
+    static func load(accountPeerId: EnginePeer.Id) -> [ProfileLink] {
+        guard let data = UserDefaults.standard.data(forKey: self.key(accountPeerId: accountPeerId)) else {
+            return []
+        }
+        return (try? JSONDecoder().decode([ProfileLink].self, from: data)) ?? []
+    }
+
+    static func save(_ links: [ProfileLink], accountPeerId: EnginePeer.Id) {
+        guard let data = try? JSONEncoder().encode(links) else {
+            return
+        }
+        UserDefaults.standard.set(data, forKey: self.key(accountPeerId: accountPeerId))
+    }
+
+    static func photoURL(fileName: String) -> URL {
+        let directory = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("profile-links", isDirectory: true)
+        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory.appendingPathComponent(fileName)
+    }
+}
+
+/// The one-line summary of a link's rules shown in the panel under its card.
+struct ProfileLinkSummaryTexts {
+    var hides: String
+    var no: String
+    var sees: String
+    var and: String
+    var phone: String
+    var lastSeen: String
+    var bio: String
+    var birthday: String
+    var stories: String
+    var gifts: String
+    var channel: String
+    var music: String
+    var calls: String
+    var voiceMessages: String
+    var groupInvites: String
+    var forwardLink: String
+}
+
+func profileLinkSummary(_ link: ProfileLink, texts: ProfileLinkSummaryTexts) -> (text: String, hidesAnything: Bool) {
+    var hidden: [String] = []
+    if !link.showPhoneNumber {
+        hidden.append(texts.phone)
+    }
+    if !link.showLastSeen {
+        hidden.append(texts.lastSeen)
+    }
+    if !link.showBio {
+        hidden.append(texts.bio)
+    }
+    if !link.showBirthday {
+        hidden.append(texts.birthday)
+    }
+    if link.stories != .all {
+        hidden.append(texts.stories)
+    }
+    if link.gifts != .all {
+        hidden.append(texts.gifts)
+    }
+    if !link.showSavedMusic {
+        hidden.append(texts.music)
+    }
+    if !link.showPersonalChannel {
+        hidden.append(texts.channel)
+    }
+    var denied: [String] = []
+    if !link.allowCalls {
+        denied.append(texts.calls)
+    }
+    if !link.allowVoiceMessages {
+        denied.append(texts.voiceMessages)
+    }
+    if !link.allowGroupInvites {
+        denied.append(texts.groupInvites)
+    }
+    if !link.allowForwardLink {
+        denied.append(texts.forwardLink)
+    }
+    func list(_ items: [String]) -> String {
+        if items.count <= 1 {
+            return items.first ?? ""
+        }
+        return items.dropLast().joined(separator: ", ") + " " + texts.and + " " + items[items.count - 1]
+    }
+    var parts: [String] = []
+    if !hidden.isEmpty {
+        parts.append(texts.hides.replacingOccurrences(of: "%@", with: hidden.joined(separator: ", ")))
+    }
+    if !denied.isEmpty {
+        parts.append(texts.no.replacingOccurrences(of: "%@", with: list(denied)))
+    }
+    if parts.isEmpty {
+        return (texts.sees, false)
+    }
+    return (parts.joined(separator: " · "), true)
+}
+
+enum ProfileLinkPalettes {
+    /// A colour id no profile colour uses: the New Link page's grey backdrop.
+    static let newLinkColorId: Int32 = -7001
+
+    static let newLink = QrStudioPalette.profile(id: ProfileLinkPalettes.newLinkColorId, center: ProfileLinkNewCardView.backdropCenter, edge: ProfileLinkNewCardView.backdropEdge)
+}
