+    var lastName: String?
+
+    var showPhoneNumber: Bool
+    var username: String?
+    var showBirthday: Bool
+    var showBio: Bool
+    var showLastSeen: Bool
+    var stories: StoriesRule
+    var gifts: GiftsRule
+    var showPersonalChannel: Bool
+
+    var allowCalls: Bool
+    var allowVoiceMessages: Bool
+    var allowGroupInvites: Bool
+    var allowForwardLink: Bool
+
+    var addToContacts: Bool
+    var chatFolderId: Int32?
+
+    // Added later; optional so that links stored by earlier builds still decode.
+    var photoModeValue: ProfileLinkPhotoMode?
+    var contactNoteValue: String?
+    var showSavedMusicValue: Bool?
+    var hideReadTimeValue: Bool?
+    var chatFolderIdsValue: [Int32]?
+    /// The channel shown instead of the profile's own personal channel.
+    var personalChannelId: Int64?
+    var personalChannelTitle: String?
+
+    var photoMode: ProfileLinkPhotoMode {
+        get {
+            return self.photoModeValue ?? .main
+        }
+        set {
+            self.photoModeValue = newValue
+        }
+    }
+
+    /// The note the contact the link adds is saved with.
+    var contactNote: String {
+        get {
+            return self.contactNoteValue ?? ""
+        }
+        set {
+            self.contactNoteValue = newValue
+        }
+    }
+
+    var showSavedMusic: Bool {
+        get {
+            return self.showSavedMusicValue ?? true
+        }
+        set {
+            self.showSavedMusicValue = newValue
+        }
+    }
+
+    /// Hides read times from the people the link hides last seen from, as the Last Seen privacy setting does.
+    var hideReadTime: Bool {
+        get {
+            return self.hideReadTimeValue ?? false
+        }
+        set {
+            self.hideReadTimeValue = newValue
+        }
+    }
+
+    /// The folders the chat with someone who opens the link goes to.
+    var chatFolderIds: [Int32] {
+        get {
