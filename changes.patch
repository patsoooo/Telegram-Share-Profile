+/// One username a link can show. `value`: nil for the main username, empty for none, else that username.
+struct ProfileLinkUsernameOption: Equatable {
+    let value: String?
+    let title: String
+    /// Under the username: "Main username", or when and where a collectible one was bought.
+    let subtitle: String?
+    /// Collectible usernames carry the Fragment logo before the subtitle.
