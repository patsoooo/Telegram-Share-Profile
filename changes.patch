+        func topicIconFile(_ emoji: String) -> TelegramMediaFile? {
+            let stripped = emoji.replacingOccurrences(of: "\u{FE0F}", with: "")
+            for candidate in [emoji, stripped, stripped + "\u{FE0F}"] {
+                if let file = self.topicIconFiles[candidate] {
+                    return file
+                }
+            }
+            return nil
+        }
+
+        private func pageIcon(_ page: ProfileLinkPage) -> ProfileLinkIcon {
+            switch page {
+            case .publicLink:
+                return .publicLink
+            case let .link(id):
