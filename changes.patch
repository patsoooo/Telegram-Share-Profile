+        self.look = look
+        self.isConfigured = false
+        self.photoFileName = nil
+        self.firstName = nil
+        self.lastName = nil
+        self.showPhoneNumber = defaults.showPhoneNumber
+        self.username = nil
+        self.showBirthday = defaults.showBirthday
+        self.showBio = defaults.showBio
+        self.showLastSeen = defaults.showLastSeen
+        self.stories = .all
+        self.gifts = defaults.showGifts ? .all : .none
+        self.showPersonalChannel = true
+        self.allowCalls = true
+        self.allowVoiceMessages = true
+        self.allowGroupInvites = true
+        self.allowForwardLink = true
+        self.addToContacts = false
+        self.chatFolderId = nil
+    }
+
+    var slug: String {
+        let allowed = CharacterSet.alphanumerics
+        let lowered = self.name.lowercased().unicodeScalars.map { allowed.contains($0) ? String($0) : "-" }.joined()
+        let trimmed = lowered.split(separator: "-").joined(separator: "-")
+        return trimmed.isEmpty ? "\(self.id)" : trimmed
+    }
+
+    /// The username this link shares: a picked collectible, the main one when none is picked, nil when hidden.
+    func displayUsername(mainUsername: String?) -> String? {
+        if let username = self.username {
+            return username.isEmpty ? nil : username
+        }
+        if let mainUsername, !mainUsername.isEmpty {
+            return mainUsername
+        }
+        return nil
+    }
+
+    func url(username: String?) -> String {
+        if let username, !username.isEmpty {
+            return "https://t.me/\(username)?=\(self.slug)"
+        }
+        return "https://t.me/?=\(self.slug)"
+    }
