+/// The last card of the carousel: a grey silhouette of a code with a plus button that creates a link.
+///
+/// The silhouette is a real code drawn with the same paths as the other cards, so it reads as one of them.
+final class ProfileLinkNewCardView: UIView {
+    private let cardView = UIView()
+    private let bodyLayer = CAShapeLayer()
+    private let ballsLayer = CAShapeLayer()
+    private let framesLayer = CAShapeLayer()
+    private let clearZoneLayer = SimpleLayer()
+    private let buttonLayer = SimpleLayer()
+    private let plusLayer = CAShapeLayer()
+    private var layoutKey: String?
+    var tapped: (() -> Void)?
+
+    static let silhouetteColor = UIColor(rgb: 0xE6E9EE)
+    static let finderColor = UIColor(rgb: 0xCDD2DB)
+    static let buttonColor = UIColor(rgb: 0x3478F6)
+    /// The screen background behind this card: a radial gradient from `center` to `edge`.
+    static let backdropCenter: UInt32 = 0x97A1B3
+    static let backdropEdge: UInt32 = 0x5D6678
+
+    /// A code of the same size as the real cards' codes, so the finders match theirs, with a quarter of the other
+    /// modules dropped (a fixed pseudo-random pattern) so the new code reads lighter than a real one.
+    private static let silhouetteMatrix: QrCodeMatrix? = {
+        guard let matrix = qrCodeMatrix(string: "https://t.me/profile-link-placeholder", ecl: "Q") else {
+            return nil
+        }
+        var seed: UInt32 = 0x5D0C0DE
+        var bits: [Bool] = []
+        bits.reserveCapacity(matrix.size * matrix.size)
+        for y in 0 ..< matrix.size {
+            for x in 0 ..< matrix.size {
+                var value = matrix[x, y]
+                if value && !matrix.isEye(x: x, y: y) {
+                    seed = seed &* 1664525 &+ 1013904223
+                    value = (seed >> 16) & 3 != 0
+                }
+                bits.append(value)
+            }
+        }
+        return QrCodeMatrix(size: matrix.size, bits: bits) ?? matrix
+    }()
+
+    private static let silhouettePaths: QrStudioCodePaths? = {
+        guard let matrix = ProfileLinkNewCardView.silhouetteMatrix else {
+            return nil
+        }
+        return QrStudioCodePaths(matrix: matrix, side: QrStudioCardMetrics.codeSide)
+    }()
+
+    /// The logo circle of a real profile code, so the plus button matches the other cards' logo.
+    private static let logoDiameter: CGFloat = {
+        guard let matrix = qrCodeMatrix(string: "https://t.me/profile-link-placeholder", ecl: "Q") else {
+            return 56.0
+        }
+        return QrStudioCodePaths(matrix: matrix, side: QrStudioCardMetrics.codeSide).logoDiameter
+    }()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.cardView.backgroundColor = .white
+        self.cardView.layer.cornerCurve = .continuous
+        self.cardView.layer.shadowColor = UIColor.black.cgColor
+        self.cardView.layer.shadowOpacity = 0.18
+        self.cardView.layer.shadowRadius = 25.0
+        self.cardView.layer.shadowOffset = CGSize(width: 0.0, height: 20.0)
+        self.addSubview(self.cardView)
+
+        self.bodyLayer.fillColor = ProfileLinkNewCardView.silhouetteColor.cgColor
+        self.cardView.layer.addSublayer(self.bodyLayer)
+        self.ballsLayer.fillColor = ProfileLinkNewCardView.silhouetteColor.cgColor
+        self.cardView.layer.addSublayer(self.ballsLayer)
+        self.framesLayer.fillColor = ProfileLinkNewCardView.finderColor.cgColor
+        self.framesLayer.fillRule = .evenOdd
+        self.cardView.layer.addSublayer(self.framesLayer)
+        // Keeps the modules clear of the button.
+        self.clearZoneLayer.backgroundColor = UIColor.white.cgColor
+        self.cardView.layer.addSublayer(self.clearZoneLayer)
+        self.buttonLayer.backgroundColor = ProfileLinkNewCardView.buttonColor.cgColor
+        self.cardView.layer.addSublayer(self.buttonLayer)
+        self.plusLayer.strokeColor = UIColor.white.cgColor
+        self.plusLayer.lineWidth = 3.0
+        self.plusLayer.lineCap = .round
+        self.cardView.layer.addSublayer(self.plusLayer)
+
+        self.addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(self.handleTap)))
+        self.isAccessibilityElement = true
+        self.accessibilityTraits = .button
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func handleTap() {
+        self.tapped?()
+    }
+
+    func update(size: CGSize, cornerRadius: CGFloat, isLimitReached: Bool, accessibilityLabel: String) {
+        self.accessibilityLabel = accessibilityLabel
+        self.cardView.frame = CGRect(origin: CGPoint(), size: size)
+        self.cardView.layer.cornerRadius = cornerRadius
+        self.cardView.layer.shadowPath = UIBezierPath(roundedRect: CGRect(origin: CGPoint(), size: size), cornerRadius: cornerRadius).cgPath
+
+        let key = "\(size)|\(isLimitReached)"
+        guard self.layoutKey != key, let paths = ProfileLinkNewCardView.silhouettePaths else {
+            return
+        }
+        self.layoutKey = key
+
+        let side = QrStudioCardMetrics.codeSide
+        let codeFrame = CGRect(x: floor((size.width - side) * 0.5), y: floor((size.height - side) * 0.5), width: side, height: side)
+        let alpha: Float = isLimitReached ? 0.5 : 1.0
+        for layer in [self.bodyLayer, self.ballsLayer, self.framesLayer] {
+            layer.frame = codeFrame
+            layer.opacity = alpha
+        }
+        self.bodyLayer.path = paths.body
+        self.ballsLayer.path = paths.balls
+        self.framesLayer.path = paths.frames
+
+        // The button matches the Telegram logo's circle on the other cards.
+        let center = CGPoint(x: codeFrame.midX, y: codeFrame.midY)
+        let buttonSide = ProfileLinkNewCardView.logoDiameter
+        self.buttonLayer.frame = CGRect(x: center.x - buttonSide * 0.5, y: center.y - buttonSide * 0.5, width: buttonSide, height: buttonSide)
+        self.buttonLayer.cornerRadius = buttonSide * 0.5
+        self.buttonLayer.backgroundColor = (isLimitReached ? UIColor(rgb: 0xB4BAC4) : ProfileLinkNewCardView.buttonColor).cgColor
+        let clearSide = buttonSide + side / CGFloat(max(1, ProfileLinkNewCardView.silhouetteMatrix?.size ?? 1)) * 1.6
+        self.clearZoneLayer.frame = CGRect(x: center.x - clearSide * 0.5, y: center.y - clearSide * 0.5, width: clearSide, height: clearSide)
+        self.clearZoneLayer.cornerRadius = clearSide * 0.5
+        let plusHalf = floor(buttonSide * 0.22)
+        let plusPath = CGMutablePath()
+        plusPath.move(to: CGPoint(x: center.x - plusHalf, y: center.y))
+        plusPath.addLine(to: CGPoint(x: center.x + plusHalf, y: center.y))
+        plusPath.move(to: CGPoint(x: center.x, y: center.y - plusHalf))
+        plusPath.addLine(to: CGPoint(x: center.x, y: center.y + plusHalf))
+        self.plusLayer.path = plusPath
+    }
+}
