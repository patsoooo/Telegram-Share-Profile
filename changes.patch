+            return [.publicLink] + self.profileLinks.map { .link($0.id) } + [.newLink]
+        }
+
+        private var currentProfileLinkPage: ProfileLinkPage {
+            let pages = self.profileLinkPages
+            return pages[max(0, min(self.profileLinkPageIndex, pages.count - 1))]
