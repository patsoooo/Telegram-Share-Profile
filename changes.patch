+/// Settings-style row icons: a glyph of the official item list set on a coloured rounded square.
+private enum ProfileLinkRulesIcons {
+    private static var cache: [String: UIImage] = [:]
+
+    static func image(_ name: String, _ color: UInt32) -> UIImage? {
+        let key = "\(name)|\(color)"
+        if let image = self.cache[key] {
+            return image
+        }
+        let image = renderSettingsIcon(name: name.contains("/") ? name : "Item List/Icons/" + name, backgroundColors: [UIColor(rgb: color)])
+        self.cache[key] = image
+        return image
+    }
+
+    static let orange: UInt32 = 0xFF9F0A
+    static let violet: UInt32 = 0x5E5CE6
+    static let red: UInt32 = 0xFF453A
+    static let teal: UInt32 = 0x00C7BE
+    static let pink: UInt32 = 0xFF2D55
+}
