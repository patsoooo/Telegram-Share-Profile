index 0000000000..c7cc4a09e0
--- /dev/null
+++ b/submodules/TelegramUI/Components/QrStudioScreen/Sources/ProfileLinkCreateSheet.swift
@@ -0,0 +1,376 @@
+import Foundation
+import UIKit
+import Display
+import ComponentFlow
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import ViewControllerComponent
+import ResizableSheetComponent
+import ListSectionComponent
+import ListTextFieldItemComponent
+import MultilineTextComponent
+import BundleIconComponent
+import GlassBarButtonComponent
+import ButtonComponent
+import LottieComponent
+
+private let profileLinkNameInputTag = NSObject()
+
+private final class ProfileLinkCreateSheetContent: Component {
+    typealias EnvironmentType = ViewControllerComponentContainer.Environment
+
+    let context: AccountContext
+    let iconEmoji: String
+    let iconFile: TelegramMediaFile?
+    let updated: (String) -> Void
+    let submit: () -> Void
+
+    init(context: AccountContext, iconEmoji: String, iconFile: TelegramMediaFile?, updated: @escaping (String) -> Void, submit: @escaping () -> Void) {
+        self.context = context
+        self.iconEmoji = iconEmoji
+        self.iconFile = iconFile
+        self.updated = updated
+        self.submit = submit
+    }
+
+    static func ==(lhs: ProfileLinkCreateSheetContent, rhs: ProfileLinkCreateSheetContent) -> Bool {
+        return lhs.context === rhs.context && lhs.iconEmoji == rhs.iconEmoji && lhs.iconFile?.fileId == rhs.iconFile?.fileId
+    }
+
+    final class View: UIView {
+        private let section = ComponentView<Empty>()
+        private let icon = ComponentView<Empty>()
+        private let iconView = ProfileLinkIconView()
+        private var shownIconFileId: Int64?
+        private var didLayout = false
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.iconView.alpha = 0.0
+            self.iconView.isUserInteractionEnabled = false
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        func update(component: ProfileLinkCreateSheetContent, availableSize: CGSize, state: EmptyComponentState, environment: Environment<ViewControllerComponentContainer.Environment>, transition: ComponentTransition) -> CGSize {
+            let environment = environment[ViewControllerComponentContainer.Environment.self].value
+            let theme = environment.theme
+            let strings = environment.strings
+            let presentationData = component.context.sharedContext.currentPresentationData.with { $0 }
+            let sideInset: CGFloat = 16.0
+            let sectionWidth = availableSize.width - sideInset * 2.0
+            // The sheet's title bar overlays the content.
+            var contentHeight: CGFloat = 82.0
+
+            let iconInset: CGFloat = 52.0
+            let sectionSize = self.section.update(
+                transition: transition,
+                component: AnyComponent(ListSectionComponent(
+                    theme: theme,
+                    style: .glass,
+                    header: nil,
+                    footer: AnyComponent(MultilineTextComponent(
+                        text: .plain(NSAttributedString(string: strings.ProfileLinks_Create_Info, font: Font.regular(presentationData.listsFontSize.itemListBaseHeaderFontSize), textColor: theme.list.freeTextColor)),
+                        maximumNumberOfLines: 0
+                    )),
+                    items: [
+                        AnyComponentWithIdentity(id: "name", component: AnyComponent(ListTextFieldItemComponent(
+                            style: .glass,
+                            theme: theme,
+                            initialText: "",
+                            placeholder: strings.ProfileLinks_Create_Placeholder,
+                            clearButtonAccessibilityLabel: strings.WebSearch_RecentSectionClear,
+                            characterLimit: 32,
+                            hasClearButton: false,
+                            autocapitalizationType: .words,
+                            returnKeyType: .done,
+                            contentInsets: UIEdgeInsets(top: 0.0, left: 0.0, bottom: 0.0, right: iconInset - 16.0),
+                            updated: { text in
+                                component.updated(text)
+                            },
+                            onReturn: {
+                                component.submit()
+                            },
+                            tag: profileLinkNameInputTag
+                        )))
+                    ],
+                    displaySeparators: false
+                )),
+                environment: {},
+                containerSize: CGSize(width: sectionWidth, height: .greatestFiniteMagnitude)
+            )
+            let sectionFrame = CGRect(origin: CGPoint(x: sideInset, y: contentHeight), size: sectionSize)
+            if let view = self.section.view {
+                if view.superview == nil {
+                    self.addSubview(view)
+                }
+                transition.setFrame(view: view, frame: sectionFrame)
+            }
+
+            // The emoji glyph the folder editor shows at the end of its name field stands in until the name
+            // suggests a topic icon (Work: the briefcase), which then takes its place.
+            let iconSize = self.icon.update(
+                transition: transition,
+                component: AnyComponent(LottieComponent(
+                    content: LottieComponent.AppBundleContent(name: "input_anim_keyToSmile"),
+                    color: theme.chat.inputPanel.inputControlColor.blitOver(theme.list.itemBlocksBackgroundColor, alpha: 1.0),
+                    size: CGSize(width: 32.0, height: 32.0)
+                )),
+                environment: {},
+                containerSize: CGSize(width: 32.0, height: 32.0)
+            )
+            if let view = self.icon.view {
+                if view.superview == nil {
+                    view.isAccessibilityElement = true
+                    view.accessibilityLabel = strings.ProfileLinks_Create_Icon
+                    self.addSubview(view)
+                }
+                let fieldHeight: CGFloat = 52.0
+                let iconFrame = CGRect(x: sectionFrame.maxX - 16.0 - iconSize.width, y: sectionFrame.minY + floor((fieldHeight - iconSize.height) * 0.5), width: iconSize.width, height: iconSize.height)
+                transition.setFrame(view: view, frame: iconFrame)
+                if self.iconView.superview == nil {
+                    self.addSubview(self.iconView)
+                }
+                self.iconView.frame = iconFrame.insetBy(dx: 2.0, dy: 2.0)
+                if let file = component.iconFile {
+                    self.iconView.update(context: component.context, icon: .emoji(component.iconEmoji), file: file, glyphColor: theme.list.itemPrimaryTextColor, size: self.iconView.bounds.size)
+                }
+                let fileId = component.iconFile?.fileId.id
+                if self.shownIconFileId != fileId {
+                    self.shownIconFileId = fileId
+                    let iconTransition: ComponentTransition = self.didLayout ? .easeInOut(duration: 0.2) : .immediate
+                    let hasIcon = fileId != nil
+                    iconTransition.setAlpha(view: self.iconView, alpha: hasIcon ? 1.0 : 0.0)
+                    iconTransition.setScale(view: self.iconView, scale: hasIcon ? 1.0 : 0.5)
+                    iconTransition.setAlpha(view: view, alpha: hasIcon ? 0.0 : 1.0)
+                    iconTransition.setScale(view: view, scale: hasIcon ? 0.5 : 1.0)
+                }
+            }
+            self.didLayout = true
+            contentHeight += sectionSize.height
+
+            // Room for the Create Link button the sheet hosts at the bottom.
+            contentHeight += 106.0 + environment.safeInsets.bottom
+            return CGSize(width: availableSize.width, height: contentHeight)
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<ViewControllerComponentContainer.Environment>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, state: state, environment: environment, transition: transition)
+    }
+}
+
+private final class ProfileLinkCreateSheetComponent: Component {
+    typealias EnvironmentType = ViewControllerComponentContainer.Environment
+
+    let context: AccountContext
+    let iconFile: (String) -> TelegramMediaFile?
+    let completion: (String, String) -> Void
+
+    init(context: AccountContext, iconFile: @escaping (String) -> TelegramMediaFile?, completion: @escaping (String, String) -> Void) {
+        self.context = context
+        self.iconFile = iconFile
+        self.completion = completion
+    }
+
+    static func ==(lhs: ProfileLinkCreateSheetComponent, rhs: ProfileLinkCreateSheetComponent) -> Bool {
+        return lhs.context === rhs.context
+    }
+
+    final class View: UIView {
+        private let sheet = ComponentView<(ViewControllerComponentContainer.Environment, ResizableSheetComponentEnvironment)>()
+        private let animateOut = ActionSlot<Action<()>>()
+        private var component: ProfileLinkCreateSheetComponent?
+        private weak var state: EmptyComponentState?
+        private var environment: ViewControllerComponentContainer.Environment?
+        private var name: String = ""
+        private var didComplete = false
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        private var trimmedName: String {
+            return self.name.trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+
+        private var iconEmoji: String {
+            return ProfileLinkIcons.suggestedEmoji(name: self.trimmedName)
+        }
+
+        private func submit() {
+            guard !self.didComplete, let component = self.component, !self.trimmedName.isEmpty else {
+                return
+            }
+            self.didComplete = true
+            let name = self.trimmedName
+            let emoji = self.iconEmoji
+            self.endEditing(true)
+            self.dismiss(animated: true, completion: {
+                component.completion(name, emoji)
+            })
+        }
+
+        private func dismiss(animated: Bool, completion: (() -> Void)? = nil) {
+            guard let environment = self.environment else {
+                return
+            }
+            self.endEditing(true)
+            if animated {
+                self.animateOut.invoke(Action { _ in
+                    environment.controller()?.dismiss(completion: nil)
+                    completion?()
+                })
+            } else {
+                environment.controller()?.dismiss(completion: nil)
+                completion?()
+            }
+        }
+
+        func update(component: ProfileLinkCreateSheetComponent, availableSize: CGSize, state: EmptyComponentState, environment: Environment<ViewControllerComponentContainer.Environment>, transition: ComponentTransition) -> CGSize {
+            self.component = component
+            self.state = state
+            let environment = environment[ViewControllerComponentContainer.Environment.self].value
+            self.environment = environment
+            let theme = environment.theme
+            let strings = environment.strings
+            let isEnabled = !self.trimmedName.isEmpty
+            let iconEmoji = self.iconEmoji
+            let iconFile = iconEmoji == ProfileLinkIcons.defaultEmoji ? nil : component.iconFile(iconEmoji)
+
+            let sheetSize = self.sheet.update(
+                transition: transition,
+                component: AnyComponent(ResizableSheetComponent<ViewControllerComponentContainer.Environment>(
+                    content: AnyComponent<ViewControllerComponentContainer.Environment>(ProfileLinkCreateSheetContent(
+                        context: component.context,
+                        iconEmoji: iconEmoji,
+                        iconFile: iconFile,
+                        updated: { [weak self] text in
+                            guard let self else {
+                                return
+                            }
+                            self.name = text
+                            Queue.mainQueue().justDispatch { [weak self] in
+                                self?.state?.updated(transition: .immediate)
+                            }
+                        },
+                        submit: { [weak self] in
+                            self?.submit()
+                        }
+                    )),
+                    titleItem: AnyComponent(MultilineTextComponent(
+                        text: .plain(NSAttributedString(string: strings.ProfileLinks_Create_Title, font: Font.semibold(17.0), textColor: theme.list.itemPrimaryTextColor)),
+                        maximumNumberOfLines: 1
+                    )),
+                    leftItem: AnyComponent(GlassBarButtonComponent(
+                        size: CGSize(width: 44.0, height: 44.0),
+                        backgroundColor: nil,
+                        isDark: theme.overallDarkAppearance,
+                        state: .glass,
+                        component: AnyComponentWithIdentity(id: "close", component: AnyComponent(
+                            BundleIconComponent(name: "Navigation/Close", tintColor: theme.chat.inputPanel.panelControlColor)
+                        )),
+                        action: { [weak self] _ in
+                            self?.dismiss(animated: true)
+                        }
+                    )),
+                    bottomItem: AnyComponent(ButtonComponent(
+                        background: ButtonComponent.Background(
+                            style: .glass,
+                            color: theme.list.itemCheckColors.fillColor,
+                            foreground: theme.list.itemCheckColors.foregroundColor,
+                            pressedColor: theme.list.itemCheckColors.fillColor.withMultipliedAlpha(0.9)
+                        ),
+                        content: AnyComponentWithIdentity(id: AnyHashable(0), component: AnyComponent(ButtonTextContentComponent(
+                            text: strings.ProfileLinks_Create_Action,
+                            badge: 0,
+                            textColor: theme.list.itemCheckColors.foregroundColor,
+                            badgeBackground: theme.list.itemCheckColors.foregroundColor,
+                            badgeForeground: theme.list.itemCheckColors.fillColor
+                        ))),
+                        isEnabled: isEnabled,
+                        displaysProgress: false,
+                        action: { [weak self] in
+                            self?.submit()
+                        }
+                    )),
+                    backgroundColor: .color(theme.list.modalBlocksBackgroundColor),
+                    animateOut: self.animateOut
+                )),
+                environment: {
+                    environment
+                    ResizableSheetComponentEnvironment(
+                        theme: theme,
+                        statusBarHeight: environment.statusBarHeight,
+                        safeInsets: environment.safeInsets,
+                        inputHeight: environment.inputHeight,
+                        metrics: environment.metrics,
+                        deviceMetrics: environment.deviceMetrics,
+                        isDisplaying: environment.isVisible,
+                        isCentered: environment.presentsFloatingPanels,
+                        screenSize: availableSize,
+                        regularMetricsSize: nil,
+                        dismiss: { [weak self] animated in
+                            self?.dismiss(animated: animated)
+                        }
+                    )
+                },
+                containerSize: availableSize
+            )
+            self.sheet.parentState = state
+            if let sheetView = self.sheet.view {
+                if sheetView.superview == nil {
+                    self.addSubview(sheetView)
+                }
+                transition.setFrame(view: sheetView, frame: CGRect(origin: CGPoint(), size: sheetSize))
+            }
+            return availableSize
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<ViewControllerComponentContainer.Environment>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, state: state, environment: environment, transition: transition)
+    }
+}
+
+/// The compact sheet that names a new profile link. `completion` receives the name and the icon's emoji.
+final class ProfileLinkCreateSheet: ViewControllerComponentContainer {
+    init(context: AccountContext, iconFile: @escaping (String) -> TelegramMediaFile?, completion: @escaping (String, String) -> Void) {
+        super.init(
+            context: context,
+            component: ProfileLinkCreateSheetComponent(context: context, iconFile: iconFile, completion: completion),
+            navigationBarAppearance: .none,
+            statusBarStyle: .ignore,
+            theme: .default
+        )
+        self.navigationPresentation = .flatModal
+        self.blocksBackgroundWhenInOverlay = true
+    }
+
+    required init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        if let view = self.node.hostView.findTaggedView(tag: profileLinkNameInputTag) as? ListTextFieldItemComponent.View {
+            view.activateInput()
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Components/QrStudioScreen/Sources/ProfileLinkPhotoSelector.swift b/submodules/TelegramUI/Components/QrStudioScreen/Sources/ProfileLinkPhotoSelector.swift
new file mode 100644
index 0000000000..e247db007a
--- /dev/null
+++ b/submodules/TelegramUI/Components/QrStudioScreen/Sources/ProfileLinkPhotoSelector.swift
@@ -0,0 +1,357 @@
+import Foundation
+import UIKit
+import Display
+import ComponentFlow
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+import AvatarNode
+import UIKitRuntimeUtils
+
+/// Which photo the people who open a link see.
+enum ProfileLinkPhotoMode: String, Codable, CaseIterable {
+    case main
+    case publicPhoto
+    case none
+}
+
+/// The avatar at the top of a link's rules. A horizontal swipe turns it over like a coin, following the finger, and
+/// the next choice (main photo, public photo, no photo; the order wraps around) is on its other side. The caption
+/// under it names the choice.
+final class ProfileLinkPhotoSelectorComponent: Component {
+    struct Option: Equatable {
+        let mode: ProfileLinkPhotoMode
+        let title: String
+    }
+
+    let context: AccountContext
+    let theme: PresentationTheme
+    let peer: EnginePeer?
+    let publicPhoto: TelegramMediaImageRepresentation?
+    let options: [Option]
+    let selected: ProfileLinkPhotoMode
+    let selectionChanged: (ProfileLinkPhotoMode) -> Void
+
+    init(context: AccountContext, theme: PresentationTheme, peer: EnginePeer?, publicPhoto: TelegramMediaImageRepresentation?, options: [Option], selected: ProfileLinkPhotoMode, selectionChanged: @escaping (ProfileLinkPhotoMode) -> Void) {
+        self.context = context
+        self.theme = theme
+        self.peer = peer
+        self.publicPhoto = publicPhoto
+        self.options = options
+        self.selected = selected
+        self.selectionChanged = selectionChanged
+    }
+
+    static func ==(lhs: ProfileLinkPhotoSelectorComponent, rhs: ProfileLinkPhotoSelectorComponent) -> Bool {
+        return lhs.context === rhs.context && lhs.theme === rhs.theme && lhs.peer == rhs.peer && lhs.publicPhoto == rhs.publicPhoto && lhs.options == rhs.options && lhs.selected == rhs.selected
+    }
+
+    final class View: UIView, UIGestureRecognizerDelegate {
+        private static let avatarSide: CGFloat = 100.0
+        private static let captionHeight: CGFloat = 24.0
+        /// The finger travel that turns the avatar half over.
+        private static let halfTurnDistance: CGFloat = 120.0
+
+        /// Holds the perspective. Every choice keeps its own avatar, loaded once, so a turn never reloads a photo:
+        /// the current one is the front, the one the turn goes to is the back, half a turn behind it.
+        private let stage = UIView()
+        private var sides: [(node: AvatarNode, shade: UIView)] = []
+        private let captionLabel = UILabel()
+        private let feedback = UISelectionFeedbackGenerator()
+
+        private var component: ProfileLinkPhotoSelectorComponent?
+        private var index: Int = 0
+        private var backIndex: Int?
+        private var angle: CGFloat = 0.0
+        private var isAnimating = false
+        private var layoutWidth: CGFloat = 0.0
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+
+            // Horizontal swipes here turn the photo; they must not close or pop the screen.
+            self.disablesInteractiveTransitionGestureRecognizer = true
+
+            var perspective = CATransform3DIdentity
+            perspective.m34 = -1.0 / 420.0
+            self.stage.layer.sublayerTransform = perspective
+            self.addSubview(self.stage)
+
+            self.captionLabel.textAlignment = .center
+            self.addSubview(self.captionLabel)
+
+            let pan = UIPanGestureRecognizer(target: self, action: #selector(self.handlePan(_:)))
+            pan.delegate = self
+            self.addGestureRecognizer(pan)
+            self.addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(self.handleTap)))
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        override func gestureRecognizerShouldBegin(_ gestureRecognizer: UIGestureRecognizer) -> Bool {
+            if let pan = gestureRecognizer as? UIPanGestureRecognizer {
+                let velocity = pan.velocity(in: self)
+                return !self.isAnimating && abs(velocity.x) > abs(velocity.y)
+            }
+            return !self.isAnimating
+        }
+
+        private func wrapped(_ index: Int) -> Int {
+            guard let count = self.component?.options.count, count > 0 else {
+                return 0
+            }
+            return ((index % count) + count) % count
+        }
+
+        @objc private func handleTap() {
+            // A tap turns the photo over to the next choice.
+            self.prepareBack(direction: -1.0)
+            self.finishTurn(to: -.pi, velocity: 0.0)
+        }
+
+        @objc private func handlePan(_ recognizer: UIPanGestureRecognizer) {
+            switch recognizer.state {
+            case .began:
+                self.feedback.prepare()
+            case .changed:
+                let translation = recognizer.translation(in: self).x
+                let angle = translation / Self.halfTurnDistance * (.pi * 0.5)
+                self.prepareBack(direction: angle == 0.0 ? -1.0 : (angle < 0.0 ? -1.0 : 1.0))
+                self.setAngle(max(-.pi, min(.pi, angle)))
+            case .ended, .cancelled:
+                let velocity = recognizer.velocity(in: self).x / Self.halfTurnDistance * (.pi * 0.5)
+                let projected = self.angle + velocity * 0.15
+                let target: CGFloat
+                if recognizer.state == .ended, abs(projected) > .pi * 0.5 {
+                    target = projected < 0.0 ? -.pi : .pi
+                } else {
+                    target = 0.0
+                }
+                self.finishTurn(to: target, velocity: velocity)
+            default:
+                break
+            }
+        }
+
+        /// Puts the choice the turn goes to on the card's back: swiping left shows the next one, right the previous.
+        private func prepareBack(direction: CGFloat) {
+            guard let component = self.component else {
+                return
+            }
+            let _ = component
+            let backIndex = self.wrapped(self.index + (direction < 0.0 ? 1 : -1))
+            if self.backIndex != backIndex {
+                self.backIndex = backIndex
+                self.updateSideVisibility()
+            }
+        }
+
+        private func updateSideVisibility() {
+            for (i, side) in self.sides.enumerated() {
+                side.node.view.isHidden = i != self.index && i != self.backIndex
+            }
+        }
+
+        private func setAngle(_ angle: CGFloat) {
+            self.angle = angle
+            CATransaction.begin()
+            CATransaction.setDisableActions(true)
+            if self.index < self.sides.count {
+                self.sides[self.index].node.view.layer.transform = self.sideTransform(angle: angle)
+            }
+            if let backIndex = self.backIndex, backIndex != self.index, backIndex < self.sides.count {
+                self.sides[backIndex].node.view.layer.transform = self.sideTransform(angle: angle + .pi)
+            }
+            CATransaction.commit()
+            self.updateShades(angle: angle)
+            // Past half a turn the caption already names what the back shows.
+            if let component = self.component {
+                let shownIndex = abs(angle) > .pi * 0.5 ? (self.backIndex ?? self.index) : self.index
+                self.updateCaption(component.options[shownIndex].title, animated: true)
+            }
+        }
+
+        /// The turn, with the card dipping a little and lifting toward the viewer at the half-way point.
+        private func sideTransform(angle: CGFloat) -> CATransform3D {
+            let lift = abs(sin(angle))
+            var transform = CATransform3DMakeScale(1.0 - 0.12 * lift, 1.0 - 0.12 * lift, 1.0)
+            transform = CATransform3DTranslate(transform, 0.0, -6.0 * lift, 0.0)
+            return CATransform3DRotate(transform, angle, 0.0, 1.0, 0.0)
+        }
+
+        /// The side turning away from the light darkens.
+        private func updateShades(angle: CGFloat) {
+            let turn = abs(sin(angle))
+            for side in self.sides {
+                side.shade.alpha = 0.35 * turn
+            }
+        }
+
+        private func finishTurn(to target: CGFloat, velocity: CGFloat) {
+            guard let component = self.component else {
+                return
+            }
+            self.isAnimating = true
+            let from = self.angle
+            let distance = abs(target - from)
+            let duration: Double = 0.5
+            // The finger's speed, as a share of the remaining turn per second.
+            let initialSpeed = distance > 0.001 ? max(-30.0, min(30.0, velocity / (target - from))) : 0.0
+            let animator = ProfileLinkPhotoTurnAnimator(duration: duration, update: { [weak self] t in
+                guard let self else {
+                    return
+                }
+                // An underdamped spring from the current angle to the target: it settles with a small overshoot.
+                let zeta: CGFloat = 0.7
+                let omega: CGFloat = 14.0
+                let dampedOmega = omega * sqrt(1.0 - zeta * zeta)
+                let x = CGFloat(t * duration)
+                let envelope = exp(-zeta * omega * x)
+                let progress = t >= 1.0 ? 1.0 : 1.0 - envelope * (cos(dampedOmega * x) + (zeta * omega - initialSpeed) / dampedOmega * sin(dampedOmega * x))
+                self.setAngle(from + (target - from) * progress)
+            }, completion: { [weak self] in
+                guard let self else {
+                    return
+                }
+                self.isAnimating = false
+                if target != 0.0, let backIndex = self.backIndex {
+                    // The back now faces the viewer, a whole turn from flat: it simply becomes the front.
+                    self.index = backIndex
+                    self.backIndex = nil
+                    self.feedback.selectionChanged()
+                    component.selectionChanged(component.options[backIndex].mode)
+                }
+                self.backIndex = nil
+                self.setAngle(0.0)
+                self.updateSideVisibility()
+                self.updateCaption(component.options[self.index].title, animated: false)
+            })
+            animator.start()
+        }
+
+        private func setAvatar(_ node: AvatarNode, option: Option, component: ProfileLinkPhotoSelectorComponent) {
+            let override: AvatarNodeImageOverride?
+            switch option.mode {
+            case .main:
+                override = nil
+            case .publicPhoto:
+                override = component.publicPhoto.flatMap { .image($0) } ?? AvatarNodeImageOverride.none
+            case .none:
+                override = AvatarNodeImageOverride.none
+            }
+            node.setPeer(context: component.context, theme: component.theme, peer: component.peer, overrideImage: override, displayDimensions: CGSize(width: Self.avatarSide, height: Self.avatarSide))
+        }
+
+        private func updateCaption(_ title: String, animated: Bool) {
+            guard let component = self.component, self.captionLabel.text != title else {
+                return
+            }
+            if animated {
+                let transition = CATransition()
+                transition.type = .fade
+                transition.duration = 0.18
+                self.captionLabel.layer.add(transition, forKey: "caption")
+            }
+            self.captionLabel.attributedText = NSAttributedString(string: title, font: Font.regular(17.0), textColor: component.theme.list.itemAccentColor)
+            self.captionLabel.accessibilityLabel = title
+        }
+
+        func update(component: ProfileLinkPhotoSelectorComponent, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+            let previous = self.component
+            self.component = component
+            if !self.isAnimating, self.angle == 0.0, let selectedIndex = component.options.firstIndex(where: { $0.mode == component.selected }) {
+                self.index = selectedIndex
+            }
+            self.layoutWidth = availableSize.width
+            let side = Self.avatarSide
+            let avatarFrame = CGRect(x: floor((availableSize.width - side) * 0.5), y: 0.0, width: side, height: side)
+            self.stage.frame = avatarFrame
+            while self.sides.count < component.options.count {
+                let node = AvatarNode(font: avatarPlaceholderFont(size: 42.0))
+                node.view.isUserInteractionEnabled = false
+                node.view.layer.isDoubleSided = false
+                let shade = UIView()
+                shade.isUserInteractionEnabled = false
+                shade.backgroundColor = .black
+                shade.alpha = 0.0
+                shade.clipsToBounds = true
+                node.view.addSubview(shade)
+                self.stage.addSubview(node.view)
+                self.sides.append((node, shade))
+            }
+            for (i, side) in self.sides.enumerated() {
+                // AvatarNode lays its content out from `frame`, which is only defined while untransformed.
+                let transform = side.node.view.layer.transform
+                side.node.view.layer.transform = CATransform3DIdentity
+                side.node.frame = CGRect(origin: CGPoint(), size: avatarFrame.size)
+                side.node.view.layer.transform = transform
+                side.shade.frame = CGRect(origin: CGPoint(), size: avatarFrame.size)
+                side.shade.layer.cornerRadius = side.node.frame.width * 0.5
+                if i < component.options.count, previous?.peer != component.peer || previous?.publicPhoto != component.publicPhoto || previous?.theme !== component.theme {
+                    self.setAvatar(side.node, option: component.options[i], component: component)
+                }
+            }
+            if !self.isAnimating {
+                self.setAngle(self.angle)
+                self.updateSideVisibility()
+                self.updateCaption(component.options[self.index].title, animated: false)
+            }
+
+            let captionY = side + 12.0
+            self.captionLabel.frame = CGRect(x: 0.0, y: captionY, width: availableSize.width, height: Self.captionHeight)
+            return CGSize(width: availableSize.width, height: captionY + Self.captionHeight)
+        }
+
+        override func point(inside point: CGPoint, with event: UIEvent?) -> Bool {
+            // Only the photo and its caption take touches, so the rest of the row still scrolls the screen.
+            let side = Self.avatarSide
+            let area = CGRect(x: (self.layoutWidth - side) * 0.5 - 40.0, y: 0.0, width: side + 80.0, height: self.bounds.height)
+            return area.contains(point)
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, state: state, environment: environment, transition: transition)
+    }
+}
+
+/// Calls `update` with the progress (0...1) on every frame for `duration`, then `completion`.
+private final class ProfileLinkPhotoTurnAnimator: NSObject {
+    private let duration: Double
+    private let update: (Double) -> Void
+    private let completion: () -> Void
+    private var displayLink: CADisplayLink?
+    private var startTime: Double = 0.0
+    private var retainedSelf: ProfileLinkPhotoTurnAnimator?
+
+    init(duration: Double, update: @escaping (Double) -> Void, completion: @escaping () -> Void) {
+        self.duration = duration
+        self.update = update
+        self.completion = completion
+    }
+
+    func start() {
+        self.retainedSelf = self
+        self.startTime = CACurrentMediaTime()
+        let displayLink = CADisplayLink(target: self, selector: #selector(self.tick))
+        displayLink.add(to: .main, forMode: .common)
+        self.displayLink = displayLink
+    }
+
+    @objc private func tick() {
+        let t = min(1.0, (CACurrentMediaTime() - self.startTime) / self.duration)
+        self.update(t)
+        if t >= 1.0 {
+            self.displayLink?.invalidate()
+            self.displayLink = nil
+            self.completion()
+            self.retainedSelf = nil
+        }
+    }
+}
