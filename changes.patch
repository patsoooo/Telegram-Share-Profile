+/// Fragment's logo on its dark circle, as the Stars transaction lists draw it.
+private func profileLinkFragmentBadge(diameter: CGFloat) -> UIImage? {
+    let icon = UIImage(bundleImageName: "Premium/Stars/Fragment")
+    return generateImage(CGSize(width: diameter, height: diameter), rotatedContext: { size, context in
+        context.clear(CGRect(origin: CGPoint(), size: size))
+        context.setFillColor(UIColor(rgb: 0x1b1f24).cgColor)
+        context.fillEllipse(in: CGRect(origin: CGPoint(), size: size))
+        if let icon, let cgImage = icon.cgImage {
+            // The PDF carries its own padding; StarsAvatarComponent insets it by 3/40 and lowers it by 2/40.
+            let iconSide = size.width * 0.85 + 2.0
+            let iconSize = icon.size.aspectFitted(CGSize(width: iconSide, height: iconSide))
+            let rect = CGRect(x: (size.width - iconSize.width) * 0.5, y: (size.height - iconSize.height) * 0.5 + size.height * 0.05, width: iconSize.width, height: iconSize.height)
+            context.saveGState()
+            context.translateBy(x: rect.midX, y: rect.midY)
+            context.scaleBy(x: 1.0, y: -1.0)
+            context.translateBy(x: -rect.midX, y: -rect.midY)
+            context.draw(cgImage, in: rect)
+            context.restoreGState()
+        }
+    })
+}
