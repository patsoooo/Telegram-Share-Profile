+/// The user's chat folders as wrapping chips inside a list block: a tap picks one folder (a second tap on the picked
+/// one clears the choice). The picked chip is filled; the others are outlined.
+final class ProfileLinkFolderChipsComponent: Component {
+    struct Folder: Equatable {
+        let id: Int32
+        let title: String
+    }
+
+    let theme: PresentationTheme
+    let folders: [Folder]
+    let selectedId: Int32?
+    let emptyText: String
+    let toggle: (Int32) -> Void
+
+    init(theme: PresentationTheme, folders: [Folder], selectedId: Int32?, emptyText: String, toggle: @escaping (Int32) -> Void) {
+        self.theme = theme
+        self.folders = folders
+        self.selectedId = selectedId
+        self.emptyText = emptyText
+        self.toggle = toggle
+    }
+
+    static func ==(lhs: ProfileLinkFolderChipsComponent, rhs: ProfileLinkFolderChipsComponent) -> Bool {
+        return lhs.theme === rhs.theme && lhs.folders == rhs.folders && lhs.selectedId == rhs.selectedId && lhs.emptyText == rhs.emptyText
+    }
+
+    final class View: UIView {
+        private final class Chip: UIButton {
+            let id: Int32
+            let background = UIView()
+            let label = UILabel()
+
+            init(id: Int32) {
+                self.id = id
+                super.init(frame: CGRect())
+                self.background.isUserInteractionEnabled = false
+                self.label.isUserInteractionEnabled = false
+                self.addSubview(self.background)
+                self.addSubview(self.label)
+            }
+
+            required init?(coder: NSCoder) {
+                fatalError("init(coder:) has not been implemented")
+            }
+
+            override var isHighlighted: Bool {
+                didSet {
+                    self.alpha = self.isHighlighted ? 0.6 : 1.0
+                }
+            }
+        }
+
+        private static let chipHeight: CGFloat = 36.0
+
+        private var chips: [Int32: Chip] = [:]
+        private let emptyLabel = UILabel()
+        private var component: ProfileLinkFolderChipsComponent?
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.addSubview(self.emptyLabel)
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        @objc private func chipPressed(_ chip: Chip) {
+            UISelectionFeedbackGenerator().selectionChanged()
+            self.component?.toggle(chip.id)
+        }
+
+        func update(component: ProfileLinkFolderChipsComponent, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+            self.component = component
+            let theme = component.theme
+            let inset: CGFloat = 16.0
+            let spacing: CGFloat = 8.0
+            let verticalInset: CGFloat = 14.0
+            let font = Font.medium(15.0)
+
+            self.emptyLabel.isHidden = !component.folders.isEmpty
+            if component.folders.isEmpty {
+                self.emptyLabel.attributedText = NSAttributedString(string: component.emptyText, font: Font.regular(17.0), textColor: theme.list.itemSecondaryTextColor)
+                let size = self.emptyLabel.sizeThatFits(CGSize(width: availableSize.width - 32.0, height: 100.0))
+                self.emptyLabel.frame = CGRect(x: 16.0, y: floor((52.0 - size.height) * 0.5), width: ceil(size.width), height: ceil(size.height))
+            }
+
+            var validIds = Set<Int32>()
+            var x = inset
+            var y = verticalInset
+            for folder in component.folders {
+                validIds.insert(folder.id)
+                let chip: Chip
+                var chipTransition = transition
+                if let current = self.chips[folder.id] {
+                    chip = current
+                } else {
+                    chip = Chip(id: folder.id)
+                    chip.addTarget(self, action: #selector(self.chipPressed(_:)), for: .touchUpInside)
+                    self.chips[folder.id] = chip
+                    self.addSubview(chip)
+                    chipTransition = .immediate
+                }
+                let isSelected = component.selectedId == folder.id
+                let textColor = isSelected ? theme.list.itemCheckColors.foregroundColor : theme.list.itemSecondaryTextColor
+                chip.label.attributedText = NSAttributedString(string: folder.title, font: font, textColor: textColor)
+                chip.accessibilityLabel = folder.title
+                chip.accessibilityTraits = isSelected ? [.button, .selected] : .button
+
+                let maxLabelWidth = availableSize.width - inset * 2.0 - 32.0
+                let labelSize = chip.label.sizeThatFits(CGSize(width: maxLabelWidth, height: Self.chipHeight))
+                let labelWidth = min(ceil(labelSize.width), maxLabelWidth)
+                let chipWidth = 16.0 + labelWidth + 16.0
+                if x + chipWidth > availableSize.width - inset, x > inset {
+                    x = inset
+                    y += Self.chipHeight + spacing
+                }
+                let chipFrame = CGRect(x: x, y: y, width: chipWidth, height: Self.chipHeight)
+                chipTransition.setFrame(view: chip, frame: chipFrame)
+                chipTransition.setFrame(view: chip.background, frame: CGRect(origin: CGPoint(), size: chipFrame.size))
+                chip.background.layer.cornerRadius = Self.chipHeight * 0.5
+                // Unselected chips sit on a light grey fill; the selected one is filled with the accent colour.
+                chipTransition.setBackgroundColor(view: chip.background, color: isSelected ? theme.list.itemAccentColor : theme.list.itemPrimaryTextColor.withMultipliedAlpha(0.07))
+                chip.background.layer.borderWidth = 0.0
+                chip.label.frame = CGRect(x: 16.0, y: floor((Self.chipHeight - ceil(labelSize.height)) * 0.5), width: labelWidth, height: ceil(labelSize.height))
+                x += chipWidth + spacing
+            }
+            for (id, chip) in self.chips where !validIds.contains(id) {
+                chip.removeFromSuperview()
+                self.chips[id] = nil
+            }
+
+            let height = component.folders.isEmpty ? 52.0 : y + Self.chipHeight + verticalInset
+            return CGSize(width: availableSize.width, height: height)
+        }
+    }
+
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, state: state, environment: environment, transition: transition)
+    }
+}
