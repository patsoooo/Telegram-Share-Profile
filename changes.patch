+
+        private func pageTitle(_ page: ProfileLinkPage, strings: PresentationStrings) -> String {
+            switch page {
+            case .publicLink:
+                return strings.ProfileLinks_Public
+            case let .link(id):
+                return self.profileLink(id: id)?.name ?? ""
+            case .newLink:
+                return strings.ProfileLinks_NewLink
+            }
+        }
+
+        private func lookSettings(for page: ProfileLinkPage) -> QrStudioLookSettings? {
+            switch page {
+            case .publicLink:
+                return self.publicLookSettings
+            case let .link(id):
+                return self.profileLink(id: id)?.look ?? self.defaultLinkLook()
+            case .newLink:
+                return QrStudioLookSettings(kind: QrStudioLook.Kind.color.rawValue, colorId: ProfileLinkPalettes.newLinkColorId, emoji: [], giftId: nil)
+            }
+        }
+
+        /// A new link takes the next backdrop of the palette that no other card uses yet.
+        private func defaultLinkLook() -> QrStudioLookSettings {
+            var used = Set<Int32>()
+            let publicSettings = self.isOnPublicPage ? self.currentSettings() : self.publicLookSettings
+            for settings in [publicSettings] + self.profileLinks.map({ $0.look }) {
+                if let backdropId = settings?.backdropId {
+                    used.insert(backdropId)
+                }
+            }
+            let ids: [Int32] = self.look.backdrops.compactMap { palette in
+                if case let .backdrop(id)? = palette.id, id != QrStudioPalette.blackBackdropId {
+                    return id
+                }
+                return nil
+            }
+            if ids.isEmpty {
+                let colorIds: [Int32] = self.look.palettes.compactMap { palette in
+                    if case let .color(id)? = palette.id, id != ProfileLinkPalettes.newLinkColorId {
+                        return id
+                    }
+                    return nil
+                }
+                let colorId = colorIds.isEmpty ? nil : colorIds[(self.profileLinks.count + 1) % colorIds.count]
+                return QrStudioLookSettings(kind: QrStudioLook.Kind.color.rawValue, colorId: colorId, emoji: [], giftId: nil)
+            }
+            // The first row of the palette is neutral greys; a new link starts among the colours.
+            let firstColour = ids.count > 12 ? 6 : 0
+            let start = firstColour + (self.profileLinks.count * 5 + 3) % (ids.count - firstColour)
+            var backdropId = ids[start]
+            for offset in 0 ..< ids.count {
+                let candidate = ids[(start + offset) % ids.count]
+                if !used.contains(candidate) {
+                    backdropId = candidate
+                    break
+                }
+            }
+            return QrStudioLookSettings(kind: QrStudioLook.Kind.color.rawValue, colorId: nil, emoji: [], giftId: nil, backdropId: backdropId)
+        }
+
+        /// Stores the current card's look before the carousel leaves it.
+        private func commitPageLook() {
+            guard self.isLookLoaded else {
+                return
+            }
+            let settings = self.currentSettings()
+            switch self.currentProfileLinkPage {
+            case .publicLink:
+                self.publicLookSettings = settings
+                self.pushShareThemeIfNeeded()
+                if let component = self.component {
+                    self.scheduleSaveLook(context: component.context)
+                }
+                self.saveWorkItem?.perform()
+                self.saveWorkItem?.cancel()
+                self.saveWorkItem = nil
+            case let .link(id):
+                self.updateProfileLink(id: id, { $0.look = settings })
+            case .newLink:
+                break
+            }
+        }
+
+        private func applyPageLook(_ settings: QrStudioLookSettings) {
+            let resolved = settings.resolve(unicodeFiles: self.unicodeEmojiFiles, customFiles: self.customEmojiFiles, giftIds: nil, hasPremium: true)
+            var look = self.look
+            look.colorId = settings.colorId
+            look.backdropId = settings.backdropId
+            look.themeId = settings.themeId
+            look.emoji = resolved.emoji.map { setting, file -> QrStudioEmojiItem in
+                if case let .unicode(unicode) = setting {
+                    return QrStudioEmojiItem(file: file, unicode: unicode)
+                }
+                return QrStudioEmojiItem(file: file, unicode: nil)
+            }
+            look.giftId = resolved.giftId
+            look.kind = QrStudioLook.Kind(rawValue: resolved.kind) ?? .color
+            if look.kind == .gift, look.selectedGift == nil {
+                look.giftId = nil
+                look.kind = .color
+            }
+            self.look = look
+            if self.look.kind == .emoji {
+                self.ensureEmojiSelection()
+            }
+        }
+
+        private func goToProfileLinkPage(_ index: Int, velocity: CGFloat = 0.0) {
+            let pages = self.profileLinkPages
+            guard index >= 0, index < pages.count, index != self.profileLinkPageIndex, !self.sheetView.isOpen else {
+                self.settleCarousel()
+                return
+            }
+            let direction: CGFloat = index > self.profileLinkPageIndex ? -1.0 : 1.0
+            self.slideOutCurrentCard(direction: direction)
+            self.commitPageLook()
+            self.profileLinkPageIndex = index
+            let page = self.currentProfileLinkPage
+            if let settings = self.lookSettings(for: page) {
+                self.applyPageLook(settings)
+            }
+            if page == .publicLink {
+                self.applyServerLookIfNeeded()
+            }
+            self.carouselOffset = 0.0
+            self.updatesCardImmediately = true
+            self.state?.updated(transition: .easeInOut(duration: 0.4))
+            self.slideInCurrentCard(from: -direction * self.carouselStep)
+            UISelectionFeedbackGenerator().selectionChanged()
+        }
+
+        private var carouselStep: CGFloat {
+            let sideMargin = (self.bounds.width - QrStudioCardMetrics.width) * 0.5
+            let gap = max(8.0, sideMargin - QrStudioScreenComponent.View.peekWidth)
+            return QrStudioCardMetrics.width + gap
+        }
+
+        private var currentCardView: UIView? {
+            return self.currentProfileLinkPage == .newLink ? self.newLinkCardView : self.card.view
+        }
+
+        private func slideOutCurrentCard(direction: CGFloat) {
+            guard let view = self.currentCardView, let snapshot = view.snapshotView(afterScreenUpdates: false) else {
+                return
+            }
+            snapshot.isUserInteractionEnabled = false
+            snapshot.center = view.center
+            snapshot.bounds = view.bounds
+            snapshot.transform = view.transform
+            self.presentationContainer.insertSubview(snapshot, belowSubview: self.sheetView)
+            let targetX = self.cardRestCenter.x + direction * self.carouselStep
+            UIView.animate(withDuration: 0.4, delay: 0.0, usingSpringWithDamping: 1.0, initialSpringVelocity: 0.0, options: [.allowUserInteraction], animations: {
+                snapshot.center = CGPoint(x: targetX, y: snapshot.center.y)
+                snapshot.alpha = 0.0
+            }, completion: { _ in
+                snapshot.removeFromSuperview()
+            })
+        }
+
+        private func slideInCurrentCard(from offset: CGFloat) {
+            var views: [UIView] = [self.leftPeekView, self.rightPeekView]
+            if let view = self.currentCardView {
+                views.append(view)
+            }
+            for view in views {
+                view.layer.animateSpring(from: offset as NSNumber, to: 0.0 as NSNumber, keyPath: "position.x", duration: 0.5, initialVelocity: 0.0, damping: 100.0, additive: true)
+            }
+            for view in [self.leftPeekView, self.rightPeekView] {
+                view.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.25)
+            }
+        }
+
+        private func settleCarousel() {
+            let from = self.carouselOffset
+            guard from != 0.0 else {
+                return
+            }
+            self.carouselOffset = 0.0
+            self.applySheetProgress(updateButtons: false)
+            var views: [UIView] = [self.leftPeekView, self.rightPeekView]
+            if let view = self.currentCardView {
+                views.append(view)
+            }
+            for view in views {
+                view.layer.animateSpring(from: from as NSNumber, to: 0.0 as NSNumber, keyPath: "position.x", duration: 0.45, initialVelocity: 0.0, damping: 100.0, additive: true)
+            }
+        }
+
+        @objc private func handleCarouselPan(_ recognizer: UIPanGestureRecognizer) {
+            let translation = recognizer.translation(in: self).x
+            let pages = self.profileLinkPages
+            switch recognizer.state {
+            case .began, .changed:
+                var offset = translation
+                if (self.profileLinkPageIndex == 0 && offset > 0.0) || (self.profileLinkPageIndex == pages.count - 1 && offset < 0.0) {
+                    offset *= 0.3
+                }
+                self.carouselOffset = offset
+                self.applySheetProgress(updateButtons: false)
+            case .ended, .cancelled, .failed:
+                let velocity = recognizer.state == .ended ? recognizer.velocity(in: self).x : 0.0
+                var target = self.profileLinkPageIndex
+                if translation < -60.0 || velocity < -500.0 {
+                    target += 1
+                } else if translation > 60.0 || velocity > 500.0 {
+                    target -= 1
+                }
+                if target != self.profileLinkPageIndex && target >= 0 && target < pages.count {
+                    // The card follows the finger to where it was released; the slide-out starts from there.
+                    self.goToProfileLinkPage(target, velocity: velocity)
+                } else {
+                    self.settleCarousel()
+                }
+            default:
+                break
+            }
+        }
+
+        private func addCarouselPan(to view: UIView) {
+            let recognizer = UIPanGestureRecognizer(target: self, action: #selector(self.handleCarouselPan(_:)))
+            recognizer.delegate = self
+            view.addGestureRecognizer(recognizer)
+            self.carouselPanRecognizers.append(recognizer)
+        }
+
+        private func setupProfileLinkViewsIfNeeded() {
+            guard self.profileLinkTitleView.superview == nil else {
+                return
+            }
+            self.presentationContainer.addSubview(self.profileLinkTitleView)
+            for view in [self.leftPeekView, self.rightPeekView, self.newLinkCardView] as [UIView] {
+                self.presentationContainer.insertSubview(view, belowSubview: self.sheetView)
+                self.addCarouselPan(to: view)
+            }
+            for view in [self.pageDotsView, self.rulesPanelView, self.linksCountPillView] as [UIView] {
+                self.presentationContainer.insertSubview(view, belowSubview: self.sheetView)
+            }
+            self.leftPeekView.tapped = { [weak self] in
+                guard let self else {
+                    return
+                }
+                self.goToProfileLinkPage(self.profileLinkPageIndex - 1)
+            }
+            self.rightPeekView.tapped = { [weak self] in
+                guard let self else {
+                    return
+                }
+                self.goToProfileLinkPage(self.profileLinkPageIndex + 1)
+            }
+            self.newLinkCardView.tapped = { [weak self] in
+                self?.openCreateLink()
+            }
+            self.rulesPanelView.tapped = { [weak self] in
+                self?.openPageRules()
+            }
+        }
+
+        private func openCreateLink() {
+            guard let component = self.component, let controller = self.environment?.controller() as? ViewController else {
+                return
+            }
+            let strings = component.context.sharedContext.currentPresentationData.with { $0 }.strings
+            if self.profileLinks.count + 1 >= ProfileLinkLimits.maxLinks {
+                UINotificationFeedbackGenerator().notificationOccurred(.error)
+                self.showToast(.image("Chat/Context Menu/Info"), strings.ProfileLinks_LimitReached("\(ProfileLinkLimits.maxLinks)").string)
+                return
+            }
+            let sheet = ProfileLinkCreateSheet(context: component.context, iconFile: { [weak self] emoji in
+                return self?.topicIconFile(emoji)
+            }, completion: { [weak self] name, emoji in
+                self?.createProfileLink(name: name, iconEmoji: emoji)
+            })
+            controller.present(sheet, in: .window(.root))
+        }
+
+        private var profileLinkRulesGifts: [ProfileLinkRulesGift] {
+            return self.look.gifts.map { ProfileLinkRulesGift(id: $0.id, title: "\($0.gift.title) #\($0.gift.number)") }
+        }
+
+        private func createProfileLink(name: String, iconEmoji: String) {
+            guard self.profileLinks.count + 1 < ProfileLinkLimits.maxLinks, self.currentProfileLinkPage == .newLink else {
+                return
+            }
+            let link = ProfileLink(id: Int64.random(in: 1 ... Int64.max), name: name, iconEmoji: iconEmoji, look: self.defaultLinkLook(), defaults: self.linkDefaults)
+            // The new card takes the New Link card's place, which moves one to the right.
+            self.slideOutCurrentCard(direction: 1.0)
+            self.profileLinks.append(link)
+            self.saveProfileLinks()
+            if let settings = link.look {
+                self.applyPageLook(settings)
+            }
+            self.carouselOffset = 0.0
+            self.updatesCardImmediately = true
+            self.state?.updated(transition: .easeInOut(duration: 0.4))
+            if let cardView = self.card.view {
+                cardView.layer.animateSpring(from: 0.6 as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.5, initialVelocity: 0.0, damping: 80.0)
+                cardView.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.2)
+            }
+            UINotificationFeedbackGenerator().notificationOccurred(.success)
+        }
+
+        private func openPageRules() {
+            guard let component = self.component, let controller = self.environment?.controller() as? ViewController else {
+                return
+            }
+            let context = component.context
+            switch self.currentProfileLinkPage {
+            case .publicLink:
+                controller.push(context.sharedContext.makePrivacyAndSecurityController(context: context))
+            case let .link(id):
+                guard let link = self.profileLink(id: id) else {
+                    return
+                }
+                let rulesController = makeProfileLinkRulesController(context: context, link: link, isNew: !link.isConfigured, iconFile: { [weak self] emoji in
+                    return self?.topicIconFile(emoji)
+                }, gifts: self.profileLinkRulesGifts, save: { [weak self] updated in
+                    guard let self else {
+                        return
+                    }
+                    self.updateProfileLink(id: id, { current in
+                        let look = current.look
+                        current = updated
+                        current.look = look
+                        current.isConfigured = true
+                    })
+                    self.requestUpdate(transition: .easeInOut(duration: 0.3))
+                }, delete: { [weak self] in
+                    self?.deleteProfileLink(id: id)
+                })
+                controller.push(rulesController)
+            case .newLink:
+                break
+            }
+        }
+
+        private func deleteProfileLink(id: Int64) {
+            guard let index = self.profileLinks.firstIndex(where: { $0.id == id }) else {
+                return
+            }
+            let wasCurrent = self.currentProfileLinkPage == .link(id)
+            self.profileLinks.remove(at: index)
+            self.saveProfileLinks()
+            guard wasCurrent else {
+                self.requestUpdate(transition: .immediate)
+                return
+            }
+            // The page index now points at the next card; step back to the previous one.
+            self.profileLinkPageIndex = index
+            let page = self.currentProfileLinkPage
+            if let settings = self.lookSettings(for: page) {
+                self.applyPageLook(settings)
+            }
+            if page == .publicLink {
+                self.applyServerLookIfNeeded()
+            }
+            self.updatesCardImmediately = true
+            self.state?.updated(transition: .easeInOut(duration: 0.4))
+        }
