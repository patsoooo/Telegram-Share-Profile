+/// The rules screen's live state, shared by the screen and its controller.
+private final class ProfileLinkRulesModel {
+    let initial: ProfileLink
+    var draft: ProfileLink
+    let iconFile: (String) -> TelegramMediaFile?
+    let gifts: [ProfileLinkRulesGift]
+    let isNew: Bool
+    var albums: [StoryListContext.State.Folder] = []
+    var folders: [ProfileLinkFolderChipsComponent.Folder] = []
+    /// How many chats each folder already holds, shown under its name in the folder sheet.
+    var folderChatCounts: [Int32: Int] = [:]
+    var peer: EnginePeer?
+    var publicPhoto: TelegramMediaImageRepresentation?
+    /// The title of the personal channel the profile itself shows.
+    var profileChannelTitle: String?
+    /// The note field's text, read back when the rules are saved.
+    var currentNote: () -> String? = { nil }
+
+    init(link: ProfileLink, iconFile: @escaping (String) -> TelegramMediaFile?, gifts: [ProfileLinkRulesGift], isNew: Bool) {
+        self.initial = link
+        self.draft = link
+        self.iconFile = iconFile
+        self.gifts = gifts
+        self.isNew = isNew
+    }
+
+    var trimmedName: String {
+        return self.draft.name.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    var draftWithNote: ProfileLink {
+        var link = self.draft
+        if link.addToContacts, let note = self.currentNote() {
+            link.contactNote = note
+        }
+        return link
+    }
+
+    var hasChanges: Bool {
+        return self.draftWithNote != self.initial
+    }
+
+    var mainUsername: String? {
+        return self.peer?.addressName
+    }
+
+    /// Usernames other than the main one: the user can only own those as collectibles bought on Fragment.
+    var collectibleUsernames: [String] {
+        guard let peer = self.peer, case let .user(user) = peer else {
+            return []
+        }
+        return user.usernames.filter { !$0.flags.contains(.isEditable) }.map(\.username)
+    }
+}
