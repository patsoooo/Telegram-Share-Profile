+            case .newLink:
+                return .newLink
+            }
+        }
+
+        private func pageIconFile(_ page: ProfileLinkPage) -> TelegramMediaFile? {
+            if case let .emoji(emoji) = self.pageIcon(page) {
+                return self.topicIconFile(emoji)
+            }
+            return nil
