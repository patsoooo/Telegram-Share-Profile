+
+/// A profile link: its own QR code with its own rules for the people who open it.
+///
+/// Demo-only: links live on this device (no server API exists for them), the encoded URL does not resolve, and
+/// the rules are not applied for the people who scan the code.
+struct ProfileLink: Codable, Equatable {
+    enum StoriesRule: Codable, Equatable {
+        case all
+        case none
+        case albums([Int64])
+        case stories([Int32])
+    }
+
+    enum GiftsRule: Codable, Equatable {
